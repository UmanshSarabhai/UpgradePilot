{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "upgradepilot",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    "LOG_LEVEL": "info",
    // workers-ai | anthropic | openai | none. Anthropic and OpenAI need ANTHROPIC_API_KEY / OPENAI_API_KEY secrets.
    "AI_PROVIDER": "workers-ai",
    // Upgrades analysed by AI per scan. The Workers AI free tier covers roughly 27 analyses a day.
    "AI_MAX_ANALYSES_PER_SCAN": "10",
    // Model calls per UTC day across all scans. Keeps a public demo inside the Workers AI free tier.
    "AI_MAX_ANALYSES_PER_DAY": "25",
    // Hourly caps on the endpoints that spend GitHub, npm and D1 quota (global, not per visitor).
    "RATE_LIMIT_INSPECT_PER_HOUR": "60",
    "RATE_LIMIT_SCANS_PER_HOUR": "20",
    "RATE_LIMIT_REANALYZE_PER_HOUR": "20"
  },
  "ai": {
    "binding": "AI"
  },
  // The Next.js static export (apps/web). /api/* runs the Worker; everything else is a static file.
  "assets": {
    "directory": "../web/out",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "upgradepilot",
      // From `wrangler d1 create upgradepilot`. Forks: create your own database and replace this ID.
      "database_id": "aacc7828-21d0-4ec7-8816-8dc62e933edf",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [{ "binding": "SCAN_QUEUE", "queue": "upgradepilot-scans" }],
    // One message per invocation: each scan step gets the full Free-plan budget (50 subrequests, 50 D1 queries).
    "consumers": [{ "queue": "upgradepilot-scans", "max_batch_size": 1, "max_retries": 3 }]
  },
  "triggers": {
    // Recovery sweep: re-enqueues scans whose step was lost or crashed.
    "crons": ["*/5 * * * *"]
  }
}
