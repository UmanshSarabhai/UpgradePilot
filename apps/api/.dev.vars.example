# Copy to .dev.vars for local development. Never commit .dev.vars.
# Optional. Fine-grained token with public read access raises the GitHub limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=
# AI analysis. Workers AI needs `wrangler login` even in local dev and spends your free neurons,
# so local runs default to none. Set to workers-ai, anthropic or openai to try it.
AI_PROVIDER=none
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AI_MODEL=

# Google sign-in (required: the whole app needs a login). From Google Cloud console > Credentials > OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string, e.g. the output of: openssl rand -base64 32
AUTH_SECRET=
# Only when using `npm run dev:web` (Next dev server on port 3000); leave unset for http://localhost:8787.
# APP_ORIGIN=http://localhost:3000
